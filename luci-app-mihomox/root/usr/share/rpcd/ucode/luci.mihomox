#!/usr/bin/ucode

'use strict';

import { access, chmod, open, popen, readfile, rename, stat, unlink, writefile } from 'fs';
import { cursor } from 'uci';
import { query as dns_query } from 'resolv';
import { get_users, get_groups, get_cgroups, load_profile } from '/etc/mihomox/ucode/include.uc';

const CORE_PATH = '/etc/mihomox/bin/mihomo';
const CORE_VERSION_FILE = '/etc/mihomox/bin/mihomo.version';
const CORE_UPDATE_SCRIPT = '/etc/mihomox/scripts/update_core.sh';
const CORE_STATUS_FILE = '/var/run/mihomox/core-update.status';
const CORE_LOCK_DIR = '/var/run/mihomox/core-update.lock';
const CORE_PENDING_FILE = '/var/run/mihomox/core-update.pending';
const PROVIDER_DISCARD_FILE = '/etc/mihomox/provider-discard.json';
const PROVIDER_FILTER_SCRIPT = '/etc/mihomox/scripts/provider_filter.sh';
const PROVIDER_FILTER_DIR = '/etc/mihomox/run/provider-filter';
const PROVIDER_FILTER_MANIFEST = PROVIDER_FILTER_DIR + '/manifest.json';
const STUN_TEST_HELPER = '/usr/libexec/mihomox/stun-test';
const APP_LOG_FILE = '/var/log/mihomox/app.log';
const CORE_LOG_FILE = '/var/log/mihomox/core.log';
const MAX_EDIT_FILE_SIZE = 16 * 1024 * 1024;
const WRITABLE_PATHS = [
	'/etc/mihomox/mixin.yaml',
	'/etc/mihomox/run/config.yaml',
	APP_LOG_FILE,
	CORE_LOG_FILE
];
const WRITABLE_PREFIXES = [
	'/etc/mihomox/profiles/',
	'/etc/mihomox/subscriptions/',
	'/etc/mihomox/run/providers/rule/',
	'/etc/mihomox/run/providers/proxy/'
];
const CORE_ARCHITECTURES = {
	'auto': true,
	'amd64-v1': true,
	'amd64-v2': true,
	'amd64-v3': true,
	'386': true,
	'arm64': true,
	'armv7': true,
	'armv6': true,
	'armv5': true,
	'mips': true,
	'mipsle': true,
	'mips64': true,
	'mips64le': true,
	'riscv64': true,
	'loong64': true
};
const CORE_CHANNELS = {
	'release': true,
	'Prerelease-Alpha': true
};
let detected_core_architecture = '';
let cached_app_version = null;

function shell_read(command) {
	let process = popen(command);
	if (!process) return '';
	let value = trim(process.read('all') || '');
	process.close();
	return value;
}

// Older ucode builds only accept string commands in popen(); quote each
// argument so array-style invocations can be flattened into one string.
function shell_quote(value) {
	return "'" + replace("" + value, /'/g, "'\\''") + "'";
}

function lock_pid_alive() {
	if (!access(CORE_LOCK_DIR + '/pid', 'r'))
		return false;
	let pid = trim(readfile(CORE_LOCK_DIR + '/pid') || '');
	if (!match(pid, /^[0-9]+$/))
		return false;
	return system('kill -0 ' + pid + ' 2>/dev/null') == 0;
}

function core_update_running() {
	/* The updater's pid lock is authoritative; a stale pending marker is not. */
	try {
		return lock_pid_alive();
	} catch (e) {
		return false;
	}
}

function read_kv(path) {
	let result = {};
	if (!access(path, 'r')) return result;
	for (let line in split(readfile(path) || '', '\n')) {
		let position = index(line, '=');
		if (position <= 0) continue;
		result[substr(line, 0, position)] = trim(substr(line, position + 1));
	}
	return result;
}

function installed_core_version() {
	let metadata = read_kv(CORE_VERSION_FILE);
	if (metadata.version) return metadata.version;
	return shell_read("" + CORE_PATH + " -v 2>/dev/null | awk '{ for (i=1; i<=NF; i++) if ($i ~ /^v[0-9]+([.][0-9]+)+/) { print $i; exit } }'");
}

function valid_api_value(value, maximum) {
	// Avoid regex \xNN classes; older ucode lexers reject them at match time.
	if (value == null || length(value) > maximum)
		return false;
	for (let i = 0; i < length(value); i++) {
		const code = ord(substr(value, i, 1));
		if (code < 32 || code == 127)
			return false;
	}
	return true;
}

function controller_url(listen, protocol, path) {
	let base = listen;
	if (!match(base, /^https?:\/\//))
		base = protocol + '://' + base;
	if (length(base) > 0 && substr(base, length(base) - 1, 1) == '/' && substr(path, 0, 1) == '/')
		base = substr(base, 0, length(base) - 1);
	return base + path;
}

function url_encode_component(value) {
	let encoded = '';
	value = '' + value;
	for (let i = 0; i < length(value); i++) {
		const character = substr(value, i, 1);
		const code = ord(character);
		if ((code >= 48 && code <= 57) || (code >= 65 && code <= 90) ||
			(code >= 97 && code <= 122) || character == '-' || character == '_' ||
			character == '.' || character == '~')
			encoded += character;
		else
			encoded += sprintf('%%%02X', code);
	}
	return encoded;
}

function provider_discard_config() {
	let config = { global: { enabled: true, concurrency: 5 }, providers: {} };
	try {
		const stored = json(readfile(PROVIDER_DISCARD_FILE) || '');
		if (stored && type(stored) == 'object')
			config = stored;
	} catch (e) {}
	if (!config.global || type(config.global) != 'object')
		config.global = { enabled: true, concurrency: 5 };
	if (!config.providers || type(config.providers) != 'object')
		config.providers = {};
	let concurrency = int(config.global.concurrency);
	config.global.enabled = config.global.enabled !== false;
	config.global.concurrency = concurrency >= 1 && concurrency <= 20 ? concurrency : 5;
	return config;
}

function write_provider_discard_config(config) {
	const temporary = PROVIDER_DISCARD_FILE + '.tmp';
	if (writefile(temporary, sprintf('%J\n', config)) == null)
		return false;
	chmod(temporary, 384);
	if (!rename(temporary, PROVIDER_DISCARD_FILE)) {
		unlink(temporary);
		return false;
	}
	return true;
}

function provider_filter_manifest() {
	try {
		const manifest = json(readfile(PROVIDER_FILTER_MANIFEST) || '');
		return manifest && type(manifest) == 'object' ? manifest : { providers: {} };
	} catch (e) {
		return { providers: {} };
	}
}

function provider_filter_state(key) {
	if (!match(key || '', /^[0-9a-f]+$/))
		return {};
	try {
		return json(readfile(PROVIDER_FILTER_DIR + '/' + key + '/state.json') || '') || {};
	} catch (e) {
		return {};
	}
}

function provider_filter_enqueue(provider, manual) {
	if (!access(PROVIDER_FILTER_SCRIPT, 'x'))
		return { success: false, error: 'manager_missing' };
	const manifest = provider_filter_manifest();
	const meta = manifest.providers?.[provider];
	if (!meta)
		return { success: false, error: 'restart_required' };
	if (meta.supported == false)
		return { success: false, error: 'unsupported_provider' };
	if (!manual && provider_discard_config().global.enabled == false)
		return { success: false, error: 'execution_disabled' };
	const action = manual ? 'manual' : 'enqueue';
	const process = popen(join(' ', map([PROVIDER_FILTER_SCRIPT, action, provider], shell_quote)), 'r');
	if (!process)
		return { success: false, error: 'start_failed' };
	process.read('all');
	return process.close() == 0
		? { success: true }
		: { success: false, error: 'queue_failed' };
}

function core_api_request(method, path, query, body) {
	let result = {};
	const profile = load_profile();
	const api_listen = profile['external-controller'];
	const api_tls_listen = profile['external-controller-tls'];
	const api_secret = profile['secret'];
	if (!api_listen && !api_tls_listen)
		return result;

	const protocol = api_tls_listen ? 'https' : 'http';
	const listen = api_tls_listen || api_listen;
	const url = controller_url(listen, protocol, path);
	const curl_args = [
		'curl', '--silent', '--show-error', '--max-time', '30',
		'--connect-timeout', '10', '--proto-default', protocol,
		'--insecure', '--request', method
	];
	if (api_secret)
		push(curl_args, '--oauth2-bearer', api_secret);
	push(curl_args, '--url-query', query || '');
	if (body)
		push(curl_args, '--header', 'Content-Type: application/json', '--data', body);
	push(curl_args, '--url', url);

	const process = popen(join(' ', map(curl_args, shell_quote)), 'r');
	if (process) {
		const output = process.read('all') || '';
		process.close();
		try { result = json(output) || {}; } catch (e) { result = {}; }
	}
	return result;
}

function writable_path(path) {
	if (!valid_api_value(path, 4096) || match(path, /(^|\/)\.\.(\/|$)/))
		return false;
	if (index(WRITABLE_PATHS, path) >= 0)
		return true;
	for (let prefix in WRITABLE_PREFIXES)
		if (substr(path, 0, length(prefix)) == prefix && length(path) > length(prefix)) {
			if (match(prefix, /profiles|subscriptions/) && !match(path, /\.(yaml|yml)$/))
				return false;
			return true;
		}
	return false;
}

function elapsed_ms(started) {
	const ended = clock(true);
	if (!started || !ended)
		return 0;
	return (ended[0] - started[0]) * 1000 + int((ended[1] - started[1]) / 1000000);
}

function system_dns_nameservers() {
	const content = readfile('/etc/resolv.conf') || '';
	let nameservers = [];
	for (let line in split(content, '\n')) {
		const fields = split(trim(line), /[ \t]+/);
		if (fields[0] == 'nameserver' && fields[1] && index(nameservers, fields[1]) < 0)
			push(nameservers, fields[1]);
	}
	return nameservers;
}

function dns_test(nameserver, server) {
	const started = clock(true);
	let result = null;
	try {
		const options = {
			type: [ 'A' ],
			timeout: 2500,
			retries: 1
		};
		if (nameserver)
			options.nameserver = [ nameserver ];
		result = dns_query('cp.cloudflare.com', options);
	} catch (e) {
		result = null;
	}
	const records = result?.['cp.cloudflare.com']?.A ?? [];
	return {
		success: length(records) > 0,
		latency: elapsed_ms(started),
		server: server || '',
		error: length(records) > 0 ? '' : 'resolve_failed'
	};
}

function direct_network_command(args) {
	const uci = cursor();
	uci.load('mihomox');
	const command = join(' ', map(args, shell_quote));
	const router_proxy = uci.get('mihomox', 'proxy', 'router_proxy');
	if (router_proxy != '1' && router_proxy != true)
		return command;
	let name = uci.get('mihomox', 'routing', 'cgroup_name') || 'mihomox';
	if (!match(name, /^[A-Za-z0-9_.-]{1,64}$/))
		name = 'mihomox';
	const paths = [
		'/sys/fs/cgroup/services/' + name + '/cgroup.procs',
		'/sys/fs/cgroup/net_cls/' + name + '/cgroup.procs'
	];
	for (let path in paths)
		if (access(path, 'w'))
			return 'sh -c ' + shell_quote(
				'echo $$ > ' + shell_quote(path) + ' || exit 125; exec ' +
				command
			);
	return null;
}

function curl_probe(url, family, proxy, proxy_auth, include_body, direct, doh) {
	const args = [
		'curl', '--silent', '--show-error', '--location',
		'--connect-timeout', '3', '--max-time', '6',
		family == 6 ? '-6' : '-4'
	];
	if (direct)
		push(args, '--noproxy', '*');
	if (doh)
		push(args, '--doh-url', 'https://dns.alidns.com/dns-query',
			'--resolve', 'dns.alidns.com:443:223.5.5.5');
	if (proxy) {
		push(args, '--proxy', proxy);
		if (proxy_auth)
			push(args, '--proxy-user', proxy_auth);
	}
	if (!include_body)
		push(args, '--output', '/dev/null');
	push(args, '--write-out', '\n__MIHOMOX__%{http_code}|%{time_total}|%{remote_ip}', url);

	const command = direct
		? direct_network_command(args)
		: join(' ', map(args, shell_quote));
	if (!command)
		return { success: false, latency: 0, error: 'isolation_unavailable' };
	const process = popen(command + ' 2>/dev/null', 'r');
	if (!process)
		return { success: false, latency: 0, error: 'start_failed' };
	const output = process.read('all') || '';
	process.close();
	const marker = '\n__MIHOMOX__';
	const marker_position = rindex(output, marker);
	if (marker_position < 0)
		return { success: false, latency: 0, error: 'request_failed' };
	const body = trim(substr(output, 0, marker_position));
	const metadata = split(trim(substr(output, marker_position + length(marker))), '|');
	const status = int(metadata[0]);
	const latency = int((metadata[1] ?? 0) * 1000);
	return {
		success: status >= 200 && status < 400,
		latency: latency,
		address: body,
		remote: metadata[2] ?? '',
		error: status >= 200 && status < 400 ? '' : 'request_failed'
	};
}

function plain_ip_probe(url, family, doh) {
	const result = curl_probe(url, family, null, null, true, true, doh);
	if (!result.success)
		return result;
	const address = trim(result.address || '');
	const valid_address = family == 6
		? index(address, ':') >= 0
		: match(address, /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/);
	result.success = !!valid_address;
	result.address = valid_address ? address : '';
	result.error = valid_address ? '' : 'invalid_result';
	return result;
}

function ipv6_probe(urls) {
	let last = { success: false, latency: 0, error: 'no_ipv6' };
	for (let url in urls) {
		const result = plain_ip_probe(url, 6, true);
		if (result.success)
			return result;
		last = result;
	}
	last.error = last.error == 'invalid_result' ? 'invalid_result' : 'no_ipv6';
	return last;
}

function resolve_public_ipv4(host) {
	const result = curl_probe(
		'https://dns.alidns.com/resolve?name=' + url_encode_component(host) + '&type=A',
		4, null, null, true, true, true
	);
	if (!result.success)
		return '';
	try {
		const response = json(result.address || '');
		for (let answer in response?.Answer || [])
			if (answer?.type == 1 && match(answer?.data || '', /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/))
				return answer.data;
	} catch (e) {}
	return '';
}

function local_dns_nameserver() {
	const profile = load_profile();
	const listen = profile?.dns?.listen ?? '';
	const parts = split(listen, ':');
	const port = int(parts[length(parts) - 1]);
	if (port <= 0 || port > 65535)
		return null;
	return `127.0.0.1#${port}`;
}

function local_proxy() {
	const profile = load_profile();
	const port = int(profile?.['mixed-port']);
	if (port <= 0 || port > 65535)
		return null;
	let auth = '';
	const uci = cursor();
	uci.load('mihomox');
	uci.foreach('mihomox', 'authentication', (section) => {
		if (!auth && (section.enabled == '1' || section.enabled == true) && section.username && section.password)
			auth = `${section.username}:${section.password}`;
	});
	return { url: `http://127.0.0.1:${port}`, auth: auth };
}

function nat_test() {
	if (!access(STUN_TEST_HELPER, 'x'))
		return { success: false, type: 'Unknown', error: 'missing_helper' };
	const primary = resolve_public_ipv4('stun.cloudflare.com');
	const secondary = resolve_public_ipv4('stun.l.google.com');
	if (!primary || !secondary)
		return { success: false, type: 'Unknown', error: 'resolve_failed' };
	const uci = cursor();
	uci.load('mihomox');
	const mark = uci.get('mihomox', 'routing', 'provider_probe_fw_mark') || '0x82';
	const command = direct_network_command([STUN_TEST_HELPER, primary, '3478', secondary, '19302', mark]);
	if (!command)
		return { success: false, type: 'Unknown', error: 'isolation_unavailable' };
	const process = popen(command, 'r');
	if (!process)
		return { success: false, type: 'Unknown', error: 'start_failed' };
	const output = process.read('all') || '';
	process.close();
	try {
		const result = json(output);
		return result || { success: false, type: 'Unknown', error: 'invalid_result' };
	} catch (e) {
		return { success: false, type: 'Unknown', error: 'invalid_result' };
	}
}

const methods = {
	version: {
		call: function() {
			if (cached_app_version == null) {
				// Prefer opkg status once; fall back to apk. Cache for process lifetime.
				let app = shell_read("opkg status luci-app-mihomox 2>/dev/null | awk -F': ' '/^Version:/{print $2; exit}'");
				if (!app)
					app = shell_read("apk list -I luci-app-mihomox 2>/dev/null | awk '{print $1; exit}' | sed 's/^luci-app-mihomox-//'");
				cached_app_version = app || '';
			}
			return { app: cached_app_version, core: installed_core_version() };
		}
	},
	profile: {
		args: { defaults: {} },
		call: function(req) {
			let profile = {};
			const defaults = req.args?.defaults ?? {};
			const filepath = '/etc/mihomox/run/config.yaml';
			const tmpFilepath = '/var/run/mihomox/profile.json';
			if (access(filepath, 'r')) {
				writefile(tmpFilepath, defaults);
				const command = `yq -M -p yaml -o json eval-all 'select(fi == 0) *? select(fi == 1)' ${tmpFilepath} ${filepath}`;
				const process = popen(command);
				if (process) {
					profile = json(process);
					process.close();
				}
			}
			return profile;
		}
	},
	update_subscription: {
		args: { section_id: 'section_id' },
		call: function(req) {
			let success = false;
			const section_id = req.args?.section_id;
			if (section_id && match(section_id, /^[A-Za-z0-9_-]{1,64}$/)) {
				let uci = cursor();
				uci.load('mihomox');
				const section = uci.get_all('mihomox', section_id);
				if (section?.['.type'] != 'subscription')
					return { success: false };
				success = system(['service', 'mihomox', 'update_subscription', section_id]) == 0;
			}
			return { success: success };
		}
	},
	core_status: {
		call: function() {
			let metadata = {};
			let state = {};
			try { metadata = read_kv(CORE_VERSION_FILE) || {}; } catch (e) {}
			try { state = read_kv(CORE_STATUS_FILE) || {}; } catch (e) {}
			/* Keep this RPC side-effect free and compatible with older ucode builds. */
			let configured = 'auto';
			try {
				configured = shell_read("uci -q get mihomox.core.architecture 2>/dev/null") || 'auto';
			} catch (e) {}
			if (!detected_core_architecture) {
				try {
					detected_core_architecture = shell_read('/etc/mihomox/scripts/update_core.sh --detect-arch 2>/dev/null');
				} catch (e) {
					detected_core_architecture = '';
				}
			}
			let detected = detected_core_architecture;
			let updating = core_update_running();
			let installed_architecture = metadata.architecture || state.architecture || detected || '';
			return {
				installed: metadata.version || '',
				installed_architecture: installed_architecture,
				latest: state.version || '',
				architecture: state.architecture || detected,
				detected_architecture: detected,
				configured_architecture: configured,
				updating: updating,
				state: state.state || 'idle',
				message: state.message || '',
				updated_at: state.updated_at || ''
			};
		}
	},
	log: {
		args: { name: 'name' },
		call: function(req) {
			const paths = {
				'app': APP_LOG_FILE,
				'core': CORE_LOG_FILE
			};
			const path = paths[req.args?.name];
			if (!path)
				return { log: '' };
			// Read via fs, not popen/tail: rpcd sandbox often cannot exec
			// helpers, which made LuCI log tabs look empty on config errors.
			let result = readfile(path);
			if (result == null)
				return { log: '' };
			result = '' + result;
			const max_bytes = 65536;
			if (length(result) > max_bytes)
				result = substr(result, length(result) - max_bytes);
			return { log: result };
		}
	},
	network_test: {
		args: { test: 'test' },
		call: function(req) {
			const test = req.args?.test;
			switch (test) {
			case 'core':
				return {
					success: system('/etc/init.d/mihomox running >/dev/null 2>&1') == 0,
					version: installed_core_version()
				};
			case 'system_dns': {
				const nameservers = system_dns_nameservers();
				return dns_test(null, join(', ', nameservers));
			}
			case 'mihomo_dns': {
				const nameserver = local_dns_nameserver();
				return nameserver
					? dns_test(nameserver, nameserver)
					: { success: false, latency: 0, server: '', error: 'not_configured' };
			}
			case 'domestic':
				return curl_probe('https://connect.rom.miui.com/generate_204', 4, null, null, false);
			case 'international': {
				const proxy = local_proxy();
				return proxy
					? curl_probe('https://cp.cloudflare.com/generate_204', 4, proxy.url, proxy.auth, false)
					: { success: false, latency: 0, error: 'not_configured' };
			}
			case 'ipv4_domestic':
				return plain_ip_probe('https://v4.ipgg.cn', 4);
			case 'ipv4_overseas':
				return plain_ip_probe('https://4.wsmdn.dpdns.org/', 4);
			case 'ipv6_domestic':
				return ipv6_probe([ 'https://v6.ipgg.cn' ]);
			case 'ipv6_overseas':
				return ipv6_probe([ 'https://6.wsmdn.dpdns.org/', 'https://ifconfig.co/ip' ]);
			case 'nat':
				return nat_test();
			default:
				return { success: false, error: 'invalid_test' };
			}
		}
	},
	provider_discard: {
		call: function() {
			const response = core_api_request('GET', '/providers/proxies', '', '');
			const manifest = provider_filter_manifest();
			const config = provider_discard_config();
			const providers = response.providers || {};
			for (let name in manifest.providers || {})
				if (!providers[name])
					providers[name] = { name: name, vehicleType: 'HTTP', proxies: [] };
			for (let name in providers) {
				const meta = manifest.providers?.[name];
				if (!meta && providers[name]?.vehicleType != 'HTTP')
					continue;
				const saved = config.providers?.[name] || {};
				providers[name].vehicleType = meta?.vehicleType || providers[name].vehicleType;
				providers[name].filterSupported = !!meta && meta.supported != false;
				providers[name].testUrl = saved.url || meta?.testUrl || providers[name].testUrl || '';
				providers[name].discardPolicy = {
					enabled: saved.enabled == true,
					url: saved.url || '',
					timeout: int(saved.timeout) || 3000,
					retries: int(saved.retries) || 0,
					concurrency: int(saved.concurrency) || config.global.concurrency
				};
				providers[name].discardStatus = meta
					? provider_filter_state(meta.key)
					: { state: 'inactive', message: 'restart_required' };
			}
			return {
				supported: true,
				isolation: 'direct',
				providers: providers,
				config: config
			};
		}
	},
	set_provider_discard_global: {
		args: { enabled: 'enabled', concurrency: 'concurrency' },
		call: function(req) {
			const enabled = req.args?.enabled == true || req.args?.enabled == 'true' || req.args?.enabled == '1';
			const concurrency = int(req.args?.concurrency);
			if (concurrency < 1 || concurrency > 20)
				return { success: false, error: 'invalid_policy' };
			const config = provider_discard_config();
			config.global.enabled = enabled;
			config.global.concurrency = concurrency;
			if (!write_provider_discard_config(config))
				return { success: false, error: 'write_failed' };
			if (!enabled)
				system(join(' ', map([PROVIDER_FILTER_SCRIPT, 'stop'], shell_quote)) + ' >/dev/null 2>&1');
			return { success: true, enabled: enabled };
		}
	},
	set_provider_discard: {
		args: { provider: 'provider', enabled: 'enabled', url: 'url', timeout: 'timeout', retries: 'retries', concurrency: 'concurrency' },
		call: function(req) {
			const provider = req.args?.provider || '';
			const enabled = req.args?.enabled == true || req.args?.enabled == 'true' || req.args?.enabled == '1';
			const url = trim(req.args?.url || '');
			const timeout = int(req.args?.timeout);
			const retries = int(req.args?.retries);
			const concurrency = int(req.args?.concurrency);
			if (!valid_api_value(provider, 256) || provider == '' ||
				!valid_api_value(url, 2048) || (url != '' && !match(url, /^https?:\/\//)) ||
				timeout < 500 || timeout > 30000 || retries < 0 || retries > 5 ||
				concurrency < 1 || concurrency > 20)
				return { success: false, error: 'invalid_policy' };

			const policy = {
				enabled: enabled,
				url: url,
				timeout: timeout,
				retries: retries,
				concurrency: concurrency
			};
			const config = provider_discard_config();
			config.global.concurrency = concurrency;
			config.providers[provider] = policy;
			if (!write_provider_discard_config(config))
				return { success: false, error: 'write_failed' };

			const result = !enabled ? provider_filter_enqueue(provider, true) : { success: true };
			return { success: true, applied: result.success, queued: result.success, policy: policy };
		}
	},
	update_provider_discard: {
		args: { provider: 'provider' },
		call: function(req) {
			const provider = req.args?.provider || '';
			if (!valid_api_value(provider, 256) || provider == '')
				return { success: false, error: 'invalid_provider' };
			const result = provider_filter_enqueue(provider, true);
			return { success: result.success, started: result.success, error: result.error };
		}
	},
	write_file: {
		args: { path: 'path', data: 'data', append: 'append', mode: 'mode', token: 'token', commit: 'commit', abort: 'abort' },
		call: function(req) {
			const path = req.args?.path;
			const data = req.args?.data ?? '';
			// Older rpcd ucode plugins only accept string arguments, so
			// booleans/numbers may arrive serialized as strings.
			const append = req.args?.append == true || req.args?.append == 'true';
			const commit = req.args?.commit == true || req.args?.commit == 'true';
			const token = req.args?.token || '';
			let mode = int(req.args?.mode);
			if (!writable_path(path) || !match(token, /^[A-Za-z0-9_-]{16,80}$/))
				return { success: false, error: 'invalid_path' };
			if (mode != 384 && mode != 420)
				mode = 420;

			const temporary = path + '.mihomox-' + token + '.tmp';
			if (req.args?.abort == true || req.args?.abort == 'true') {
				unlink(temporary);
				return { success: true };
			}
			if (!append)
				unlink(temporary);
			const handle = open(temporary, append ? 'a' : 'w', 384);
			if (!handle)
				return { success: false, error: 'open_failed' };
			const written = handle.write(data);
			handle.close();
			const file_stat = stat(temporary);
			if (written === null || !file_stat || file_stat.size > MAX_EDIT_FILE_SIZE) {
				unlink(temporary);
				return { success: false, error: file_stat?.size > MAX_EDIT_FILE_SIZE ? 'file_too_large' : 'write_failed' };
			}
			if (commit) {
				if (!chmod(temporary, mode) || !rename(temporary, path)) {
					unlink(temporary);
					return { success: false, error: 'commit_failed' };
				}
			}
			return { success: true, size: file_stat.size };
		}
	},
	update_core: {
		args: { channel: 'channel', architecture: 'architecture', mirror_prefix: 'mirror_prefix', download_url: 'download_url', download_sha256: 'download_sha256' },
		call: function(req) {
			let configured_channel = shell_read("uci -q get mihomox.core.channel 2>/dev/null") || 'Prerelease-Alpha';
			let channel = req.args?.channel || configured_channel;
			let architecture = req.args?.architecture || 'auto';
			let mirror_prefix = req.args?.mirror_prefix || '';
			let download_url = req.args?.download_url || '';
			let download_sha256 = req.args?.download_sha256 || '';
			if (!CORE_CHANNELS[channel])
				return { success: false, error: 'invalid_channel' };
			if (!CORE_ARCHITECTURES[architecture])
				return { success: false, error: 'invalid_architecture' };
			if (length(mirror_prefix) > 2048 || length(download_url) > 2048 ||
				match(mirror_prefix, /[\r\n]/) || match(download_url, /[\r\n]/))
				return { success: false, error: 'invalid_url' };
			if ((mirror_prefix && !match(mirror_prefix, /^https?:\/\//)) ||
				(download_url && !match(download_url, /^https?:\/\//)))
				return { success: false, error: 'invalid_url' };
			if (length(download_sha256) > 128 || (download_sha256 && !match(download_sha256, /^[0-9a-fA-F]{64}$/)))
				return { success: false, error: 'invalid_sha256' };
			if (download_url && !download_sha256)
				return { success: false, error: 'custom_sha256_required' };
			if (!access(CORE_UPDATE_SCRIPT, 'x'))
				return { success: false, error: 'missing_script' };
			if (system('mkdir -p /var/run/mihomox /var/log/mihomox') != 0)
				return { success: false, error: 'runtime_directory_failed' };

			let uci = cursor();
			uci.load('mihomox');
			uci.set('mihomox', 'core', 'channel', channel);
			uci.set('mihomox', 'core', 'architecture', architecture);
			uci.set('mihomox', 'core', 'mirror_prefix', mirror_prefix);
			uci.set('mihomox', 'core', 'download_url', download_url);
			uci.set('mihomox', 'core', 'download_sha256', download_sha256);
			if (!uci.commit('mihomox'))
				return { success: false, error: 'save_failed' };
			if (shell_read("uci -q get mihomox.core.channel 2>/dev/null") != channel)
				return { success: false, error: 'save_failed' };
			if (core_update_running())
				return {
					success: true,
					started: false,
					running: true,
					channel: channel,
					message: 'update_already_running'
				};

			if (writefile(CORE_PENDING_FILE, 'pending\n') === null)
				return { success: false, error: 'lock_failed' };

			let start_cmds = [
				'setsid ' + CORE_UPDATE_SCRIPT + ' >>/var/log/mihomox/core-update.log 2>&1 </dev/null &',
				'nohup ' + CORE_UPDATE_SCRIPT + ' >>/var/log/mihomox/core-update.log 2>&1 </dev/null &',
				'nohup /etc/init.d/mihomox update_core >>/var/log/mihomox/core-update.log 2>&1 </dev/null &'
			];
			let started = false;
			for (let cmd in start_cmds) {
				if (system(cmd) == 0) {
					started = true;
					break;
				}
			}
			if (!started) {
				unlink(CORE_PENDING_FILE);
				return { success: false, error: 'start_failed' };
			}
			return { success: true, started: true, running: true, channel: channel };
		}
	},
	api: {
		args: { method: 'method', path: 'path', query: 'query', body: 'body' },
		call: function(req) {
			const method = req.args?.method || 'GET';
			const path = req.args?.path || '/';
			const query = req.args?.query || '';
			const body = req.args?.body || '';
			if (!match(method, /^(GET|POST|PUT|PATCH|DELETE|OPTIONS)$/) ||
				!match(path, /^\/[^\r\n]*$/) ||
				!valid_api_value(path, 4096) ||
				!valid_api_value(query, 8192) ||
				!valid_api_value(body, 1048576))
					return {};
			return core_api_request(method, path, query, body);
		}
	},
	get_identifiers: {
		call: function() {
			const users = filter(get_users(), (x) => x != '');
			const groups = filter(get_groups(), (x) => x != '');
			const cgroups = filter(get_cgroups(), (x) => x != '' && index(x, 'services/mihomox') < 0);
			return { users: users, groups: groups, cgroups: cgroups };
		}
	},
	debug: {
		call: function() {
			const success = system('/etc/mihomox/scripts/debug.sh > /var/log/mihomox/debug.log') == 0;
			return { success: success };
		}
	}
};

return { 'luci.mihomox': methods };
