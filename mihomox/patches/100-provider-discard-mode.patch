@@ -0,0 +1,48 @@
+package resource
+
+import (
+	"context"
+	"testing"
+
+	"github.com/metacubex/mihomo/common/utils"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type unchangedVehicle struct {
+	buf  []byte
+	hash utils.HashType
+}
+
+func (v *unchangedVehicle) Read(context.Context, utils.HashType) ([]byte, utils.HashType, error) {
+	return v.buf, v.hash, nil
+}
+func (v *unchangedVehicle) Write([]byte) error  { return nil }
+func (v *unchangedVehicle) Path() string        { return "" }
+func (v *unchangedVehicle) Url() string         { return "" }
+func (v *unchangedVehicle) Proxy() string       { return "" }
+func (v *unchangedVehicle) Type() P.VehicleType { return P.HTTP }
+
+func TestOnUnchangedRunsForScheduledPull(t *testing.T) {
+	buf := []byte("same")
+	vehicle := &unchangedVehicle{buf: buf, hash: utils.MakeHash(buf)}
+	updates := 0
+	unchanged := 0
+	fetcher := NewFetcher("test", 0, vehicle, nil, func(value []byte) ([]byte, error) {
+		return value, nil
+	}, func([]byte) {
+		updates++
+	})
+	fetcher.SetOnUnchanged(func() {
+		unchanged++
+	})
+
+	fetcher.updateWithLog()
+	fetcher.updateWithLog()
+
+	if updates != 1 {
+		t.Fatalf("expected one content update, got %d", updates)
+	}
+	if unchanged != 1 {
+		t.Fatalf("expected one unchanged callback, got %d", unchanged)
+	}
+}
