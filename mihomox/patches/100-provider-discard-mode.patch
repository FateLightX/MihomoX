+func TestNormalizeDiscardPolicy(t *testing.T) {
+	policy := normalizeDiscardPolicy(P.DiscardPolicy{
+		Enabled:     true,
+		Timeout:     60000,
+		Retries:     10,
+		Concurrency: 100,
+	})
+	if !policy.Enabled || policy.Timeout != 3000 || policy.Retries != 5 || policy.Concurrency != 5 {
+		t.Fatalf("unexpected normalized policy: %+v", policy)
+	}
+}
