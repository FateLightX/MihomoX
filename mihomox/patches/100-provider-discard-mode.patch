+func loadDiscardPolicy(name string) P.DiscardPolicy {
+	path := os.Getenv("MIHOMO_PROVIDER_DISCARD_FILE")
+	if path == "" {
+		return P.DiscardPolicy{}
+	}
+	buf, err := os.ReadFile(path)
+	if err != nil {
+		return P.DiscardPolicy{}
+	}
+	var config discardPolicyFile
+	if json.Unmarshal(buf, &config) != nil {
+		return P.DiscardPolicy{}
+	}
+	return config.Providers[name]
+}
+
+func normalizeDiscardPolicy(policy P.DiscardPolicy) P.DiscardPolicy {
+	if policy.Timeout == 0 || policy.Timeout > 30000 {
+		policy.Timeout = 3000
+	}
+	if policy.Retries > 5 {
+		policy.Retries = 5
+	}
+	if policy.Concurrency == 0 || policy.Concurrency > 20 {
+		policy.Concurrency = 5
+	}
+	return policy
+}
+
+func (pp *proxySetProvider) SetDiscardPolicy(policy P.DiscardPolicy) {
+	policy = normalizeDiscardPolicy(policy)
+	pp.discardMu.Lock()
+	pp.discardPolicy = policy
+	pp.discardMu.Unlock()
+	if !policy.Enabled {
+		pp.candidatesMu.RLock()
+		proxies := append([]C.Proxy(nil), pp.candidates...)
+		pp.candidatesMu.RUnlock()
+		if len(proxies) != 0 {
+			pp.baseProvider.setProxies(proxies)
+			pp.setDiscardStatus(P.DiscardStatus{State: "disabled", Total: len(proxies), Available: len(proxies)})
+		}
+	}
+}
+
+func (pp *proxySetProvider) DiscardPolicy() P.DiscardPolicy {
+	pp.discardMu.RLock()
+	defer pp.discardMu.RUnlock()
+	return pp.discardPolicy
+}
+
+func (pp *proxySetProvider) DiscardStatus() P.DiscardStatus {
+	pp.discardMu.RLock()
+	defer pp.discardMu.RUnlock()
+	return pp.discardStatus
+}
+
+func (pp *proxySetProvider) setDiscardStatus(status P.DiscardStatus) {
+	status.UpdatedAt = time.Now().Format(time.RFC3339)
+	pp.discardMu.Lock()
+	pp.discardStatus = status
+	pp.discardMu.Unlock()
+}
+
+func (pp *proxySetProvider) StartDiscardUpdate() bool {
+	pp.updateMu.Lock()
+	if pp.updateRunning {
+		pp.updateMu.Unlock()
+		return false
+	}
+	pp.updateRunning = true
+	pp.updateMu.Unlock()
+	go func() {
+		err := pp.Update()
+		if err != nil {
+			status := pp.DiscardStatus()
+			status.State = "failed"
+			status.Message = err.Error()
+			pp.setDiscardStatus(status)
+		}
+		pp.updateMu.Lock()
+		pp.updateRunning = false
+		pp.updateMu.Unlock()
+	}()
+	return true
+}
+
+func (pp *proxySetProvider) filterAvailable(proxies []C.Proxy, policy P.DiscardPolicy) []C.Proxy {
+	url := strings.TrimSpace(policy.URL)
+	if url == "" {
+		url = strings.TrimSpace(pp.healthCheck.url)
+	}
+	if url == "" {
+		url = C.DefaultTestURL
+	}
+	available := make([]bool, len(proxies))
+	progressMu := new(sync.Mutex)
+	tested := 0
+	alive := 0
+	group := new(errgroup.Group)
+	group.SetLimit(int(policy.Concurrency))
+	for index, proxy := range proxies {
+		index, proxy := index, proxy
+		group.Go(func() error {
+			for attempt := uint(0); attempt <= policy.Retries; attempt++ {
+				ctx, cancel := context.WithTimeout(context.Background(), time.Duration(policy.Timeout)*time.Millisecond)
+				_, err := proxy.URLTest(ctx, url, pp.healthCheck.expectedStatus)
+				cancel()
+				if err == nil {
+					available[index] = true
+					break
+				}
+			}
+			progressMu.Lock()
+			tested++
+			if available[index] {
+				alive++
+			}
+			pp.setDiscardStatus(P.DiscardStatus{
+				State:     "testing",
+				Total:     len(proxies),
+				Tested:    tested,
+				Available: alive,
+				Discarded: tested - alive,
+			})
+			progressMu.Unlock()
+			return nil
+		})
+	}
+	_ = group.Wait()
+	filtered := make([]C.Proxy, 0, len(proxies))
+	for index, proxy := range proxies {
+		if available[index] {
+			filtered = append(filtered, proxy)
+		}
+	}
+	return filtered
+}
+
+func (pp *proxySetProvider) setProxies(proxies []C.Proxy) {
+	pp.candidatesMu.Lock()
+	pp.candidates = append(pp.candidates[:0], proxies...)
+	pp.candidatesMu.Unlock()
+	pp.applyCandidates(proxies)
+}
+
+func (pp *proxySetProvider) retestCandidates() {
+	if !pp.DiscardPolicy().Enabled {
+		return
+	}
+	pp.candidatesMu.RLock()
+	proxies := append([]C.Proxy(nil), pp.candidates...)
+	pp.candidatesMu.RUnlock()
+	if len(proxies) != 0 {
+		pp.applyCandidates(proxies)
+	}
+}
+
+func (pp *proxySetProvider) applyCandidates(proxies []C.Proxy) {
+	policy := pp.DiscardPolicy()
+	if !policy.Enabled {
+		pp.baseProvider.setProxies(proxies)
+		pp.setDiscardStatus(P.DiscardStatus{State: "disabled", Total: len(proxies), Available: len(proxies)})
+		return
+	}
+
+	discardProviderWorker.Lock()
+	defer discardProviderWorker.Unlock()
+	pp.setDiscardStatus(P.DiscardStatus{State: "testing", Total: len(proxies), Available: pp.Count()})
+	available := pp.filterAvailable(proxies, policy)
+	if !pp.DiscardPolicy().Enabled {
+		return
+	}
+	status := P.DiscardStatus{
+		Total:     len(proxies),
+		Tested:    len(proxies),
+		Available: len(available),
+		Discarded: len(proxies) - len(available),
+	}
+	if len(available) == 0 {
+		status.State = "retained"
+		currentCount := pp.Count()
+		if currentCount == 0 {
+			pp.baseProvider.setProxies(proxies)
+			status.State = "fallback"
+			status.Available = len(proxies)
+			status.Discarded = 0
+			status.Message = "all candidates unavailable; kept complete candidate set on initial load"
+		} else {
+			status.Available = currentCount
+			status.Message = "all candidates unavailable; retained previous provider"
+		}
+		pp.setDiscardStatus(status)
+		return
+	}
+	pp.baseProvider.setProxies(available)
+	status.State = "active"
+	pp.setDiscardStatus(status)
 }
 
