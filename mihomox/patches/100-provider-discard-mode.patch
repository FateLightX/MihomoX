+func getDiscardController(r *http.Request) (P.DiscardController, bool) {
+	provider := r.Context().Value(CtxKeyProvider).(P.ProxyProvider)
+	controller, ok := provider.(P.DiscardController)
+	return controller, ok
+}
+
+func getProviderDiscardStatus(w http.ResponseWriter, r *http.Request) {
+	controller, ok := getDiscardController(r)
+	if !ok {
+		render.Status(r, http.StatusNotImplemented)
+		render.JSON(w, r, newError("provider discard is not supported"))
+		return
+	}
+	render.JSON(w, r, render.M{
+		"policy": controller.DiscardPolicy(),
+		"status": controller.DiscardStatus(),
+	})
+}
+
+func setProviderDiscardPolicy(w http.ResponseWriter, r *http.Request) {
+	controller, ok := getDiscardController(r)
+	if !ok {
+		render.Status(r, http.StatusNotImplemented)
+		render.JSON(w, r, newError("provider discard is not supported"))
+		return
+	}
+	policy := P.DiscardPolicy{}
+	if err := render.DecodeJSON(r.Body, &policy); err != nil {
+		render.Status(r, http.StatusBadRequest)
+		render.JSON(w, r, ErrBadRequest)
+		return
+	}
+	controller.SetDiscardPolicy(policy)
+	render.JSON(w, r, render.M{"policy": controller.DiscardPolicy()})
+}
+
+func updateProviderWithDiscard(w http.ResponseWriter, r *http.Request) {
+	controller, ok := getDiscardController(r)
+	if !ok {
+		render.Status(r, http.StatusNotImplemented)
+		render.JSON(w, r, newError("provider discard is not supported"))
+		return
+	}
+	if !controller.StartDiscardUpdate() {
+		render.Status(r, http.StatusConflict)
+		render.JSON(w, r, newError("provider update already running"))
+		return
+	}
+	render.Status(r, http.StatusAccepted)
+	render.JSON(w, r, render.M{"started": true})
+}
